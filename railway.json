{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watch": ["apps/api/**", "apps/api/requirements.lock"],
    "buildCommand": "pip install uv && cd apps/api && uv pip install --system -r requirements.lock"
  },
  "deploy": {
    "startCommand": "cd apps/api && python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/v1/leagues",
    "healthcheckTimeout": 100
  }
}
