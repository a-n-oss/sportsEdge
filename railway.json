{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watch": ["apps/api/**"]
  },
  "deploy": {
    "preDeployCommand": ["python -m alembic upgrade head"],
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
