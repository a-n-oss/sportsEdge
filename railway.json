{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watch": ["apps/api/**"],
    "nixpacksPlan": {
      "providers": ["python"],
      "variables": {
        "NIXPACKS_PYTHON_PACKAGE_MANAGER": "uv"
      },
      "phases": {
        "install": {
          "cmds": ["cd apps/api && uv pip install -r requirements.lock"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd apps/api && python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/v1/leagues",
    "healthcheckTimeout": 100
  }
}
