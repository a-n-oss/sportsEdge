# Local/dev only. Production (Railway) requires a real ADMIN_TOKEN and
# refuses the documented default `development_token`. See docs/ops.md.

DATABASE_URL=postgresql+asyncpg://sportsedge:sportsedge_password@localhost:5432/sportsedge_db
ADMIN_TOKEN=secret_admin_token
CORS_ORIGINS=http://localhost:3000

# Do not set SKIP_MIGRATIONS=1 unless Alembic is run by another command.
# SKIP_MIGRATIONS=1 silently skips schema upgrades on API boot.
# SKIP_MIGRATIONS=0

# Playwright e2e / seed-locked runs: skip the ESPN cron so live scoreboard
# upserts cannot overwrite GSW / Boston Celtics fixtures.
# SKIP_ESPN_SCHEDULER=1
