{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watch": ["**"],
    "nixpacksPlan": {
      "variables": {
        "NIXPACKS_PYTHON_PACKAGE_MANAGER": "uv"
      }
    }
  },
  "deploy": {
    "startCommand": "python -m uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/v1/leagues",
    "healthcheckTimeout": 100
  }
}
